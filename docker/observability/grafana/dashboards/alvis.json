{
  "uid": "alvis-ingestion",
  "title": "Alvis — ingestion flows",
  "tags": ["alvis", "ingestion"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "source",
        "type": "query",
        "query": {"query": "label_values(pipeline_runs_total, source)"},
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "index",
        "type": "query",
        "query": {"query": "label_values(pipeline_runs_total, index)"},
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Runs",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {"unit": "ops", "min": 0},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, index) (rate(pipeline_runs_total{source=~\"$source\", index=~\"$index\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failures",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {"unit": "ops", "min": 0},
        "overrides": [{"matcher": {"id": "byName", "options": "failures"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]}]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, index) (rate(pipeline_failures_total{source=~\"$source\", index=~\"$index\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Documents & chunks",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "docsps"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, index) (rate(pipeline_documents_total{source=~\"$source\", index=~\"$index\"}[$__rate_interval]))",
          "legendFormat": "documents {{source}}/{{index}}"
        },
        {
          "refId": "B",
          "expr": "sum by (source, index) (rate(pipeline_chunks_total{source=~\"$source\", index=~\"$index\"}[$__rate_interval]))",
          "legendFormat": "chunks {{source}}/{{index}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Changed / skipped / deleted",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "docsps"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, index) (rate(pipeline_changed_total{source=~\"$source\", index=~\"$index\"}[$__rate_interval]))",
          "legendFormat": "changed {{source}}/{{index}}"
        },
        {
          "refId": "B",
          "expr": "sum by (source, index) (rate(pipeline_skipped_total{source=~\"$source\", index=~\"$index\"}[$__rate_interval]))",
          "legendFormat": "skipped {{source}}/{{index}}"
        },
        {
          "refId": "C",
          "expr": "sum by (source, index) (rate(pipeline_deleted_total{source=~\"$source\", index=~\"$index\"}[$__rate_interval]))",
          "legendFormat": "deleted {{source}}/{{index}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Run duration p95",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, source, index) (rate(pipeline_duration_seconds_bucket{source=~\"$source\", index=~\"$index\"}[$__rate_interval])))",
          "legendFormat": "p95 {{source}}/{{index}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Stage duration p95 (by stage)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, source, index, stage) (rate(pipeline_stage_seconds_bucket{source=~\"$source\", index=~\"$index\"}[$__rate_interval]))) * 1000",
          "legendFormat": "{{stage}} {{source}}/{{index}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Skip ratio",
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pipeline_skipped_total{source=~\"$source\", index=~\"$index\"}[$__rate_interval])) / clamp_min(sum(rate(pipeline_documents_total{source=~\"$source\", index=~\"$index\"}[$__rate_interval])), 0.0001)"
        }
      ]
    }
  ]
}